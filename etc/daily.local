# -*- mode: sh; -*-
PATH=/usr/local/www/bliptown/bin:/usr/pkg/bin:/usr/pkg/sbin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH

production=false
staging=false

[ $(hostname) = avalon.blip.town ] && production=true
[ $(hostname) = epoch.staging-blip.town ] && staging=true

cleanup() {
	rm -f $tmpfiles
}
trap cleanup EXIT

backup() {
	ok=true
	checksum_dir=/root/dump_checksums
	mnt=/mnt/box
	dump_dir=dumps
	storage_box=u597578@u597578.your-storagebox.de

	echo "Making backups:"

	mkdir -p "$checksum_dir"

	weekday=$(date +%u)
	monthday=$(date +%e)

	if [ $monthday = 1 ]; then
		backup_type="monthly"
		dump_level=0
	elif [ $weekday = 7 ]; then
		 backup_type="weekly"
		 dump_level=0
	else
		backup_type="daily"
		dump_level=1
	fi
	
	dump="$(date +%F).dump"
	fifo="/tmp/${dump}.fifo"
	tmpfiles="$fifo $tmpfiles"

	mkfifo "$fifo"
	md5 < "$fifo" > "$checksum_dir/${dump}.md5" 2>/dev/null &

	dump -${dump_level}Xuaf - / 2>/dev/null | tee "$fifo" |
		ssh -p23 "$storage_box" "dd of=${dump_dir}/${backup_type}/${dump}" || ok=false
	$ok || { echo "Dump failed" >&2; return 1; }

	local_checksum=$(cat "$checksum_dir/${dump}.md5")
	remote_checksum=$(ssh -p23 "$storage_box" "md5 -r ${dump_dir}/${backup_type}/${dump}" | cut -d' '  -f1)
	[ "$local_checksum" = "$remote_checksum" ] || ok=false
	$ok || { echo "Dump $dump checksum does not match" >&2; return 1; }

	echo "Done"
	echo

	ok=true
	echo "Deleting old backups:"

	mount_psshfs -O Port=23 "${storage_box}:" "$mnt"

	find "${mnt}/${dump_dir}/daily" -name "*.dump" -mtime +7 -delete || ok=false
	find "${mnt}/${dump_dir}/weekly" -name "*.dump" -mtime +30 -delete || ok=false
	find "${mnt}/${dump_dir}/monthly" -name "*.dump" -mtime +365 -delete || ok=false

	umount "$mnt"
	$ok || { echo "Failed" >&2; return 1; }
	echo "Done"
}

if $production; then
	backup
fi
echo

if $staging; then
	echo "Syncing from production:"
	ok=true
	for d in /home/bliptown/users/ /home/bliptown/domains/ /var/db/bliptown/backups/; do
		rsync -a --delete bliptown@blip.town:$d $d || ok=false
		chown -Rh bliptown:bliptown $d
	done
	chmod -R 600 /var/db/bliptown/backups
	$ok && echo "Done" || echo "Failed"
	echo

	echo "Pulling repo changes:"
	ok=true
	for d in /home/bliptown/repos/*.git; do
		/usr/pkg/bin/git -C "$d" fetch origin master >/dev/null
	done
	$ok && echo "Done" || echo "Failed"
echo
fi

echo "Expunging database dead tokens:"
ok=true
now=$(date +%s)
sqlite3 /var/db/bliptown/users.db "DELETE FROM login_tokens WHERE expires < $now" || ok=false
$ok && echo "Done" || echo "Failed"
echo

echo "Checking database integrity:"
ok=true
sqlite3 /var/db/bliptown/users.db "PRAGMA integrity_check" >/dev/null || ok=false
$ok && echo "Done" || echo "Failed"
echo

if $production; then
	echo "Creating database backup:"
	ok=true
	date=$(date +%F)
	backup_db="/var/db/bliptown/backups/users-${date}.db"
	sqlite3 /var/db/bliptown/users.db ".backup $backup_db" || ok=false
	chown bliptown:bliptown "$backup_db"
	chmod 0600 "$backup_db"
	$ok && echo "Done" || echo "Failed"
	echo
fi

echo "Deleting old database backups:"
ok=true
find /var/db/bliptown/backups -name '*.db' -mtime +30 -delete || ok=false
$ok && echo "Done" || echo "Failed"
echo

echo "Blocking malicious IPs:"
ok=true
npf-badhost || ok=false
$ok && echo "Done" || echo "Failed"
echo
