# -*- mode: sh; -*-
cleanup() {
	rm -f $tmpfiles
}
trap cleanup EXIT

fetch_cert() {
	ok=true
	porkbun_payload=/etc/ssl/private/porkbun-keys.json
	expected_a_record=89.167.48.186
	expected_aaaa_record=2a01:4f9:c014:ebe2::1
	domain=$1
	endpoint="https://api.porkbun.com/api/json/v3/ssl/retrieve/${domain}"
	cert_chain="/etc/ssl/${domain}.crt"
	cert_key="/etc/ssl/private/${domain}.key"
	json_tmp=$(mktemp)
	tmpfiles="$json_tmp $tmpfiles"

	echo "Fetching certificate: $domain"
	/usr/local/bin/curl -fsS -X POST -d "@$porkbun_payload" -m 30 "$endpoint" > "$json_tmp" || ok=false
	$ok || { echo "Fetch failed" >&2; return 1; }

	cert_chain_tmp=$(mktemp)
	tmpfiles="$cert_chain_tmp $tmpfiles"
	cert_key_tmp=$(mktemp)
	tmpfiles="$cert_key_tmp $tmpfiles"

	/usr/local/bin/jq -r .certificatechain < "$json_tmp" > "$cert_chain_tmp" || ok=false
	/usr/local/bin/jq -r .privatekey       < "$json_tmp" > "$cert_key_tmp"   || ok=false
	$ok || { echo "Malformed JSON response" >&2; return 1; }

	cert_hash=$(openssl x509 -in "$cert_chain_tmp" -pubkey | openssl pkey -pubin | md5)
	key_hash=$(openssl pkey -in "$cert_key_tmp" -pubout | md5)

	echo "Matching certificate with key:"
	[ "X$cert_hash" == "X$key_hash" ] || ok=false
	$ok || { echo "Failed" >&2; return 1; }
	echo "Succeeded"
	echo
	echo "Installing certificates:"

	install -m 0644 -o root -g wheel "$cert_chain_tmp" "$cert_chain" && echo "$cert_chain installed" || ok=false
	$ok || { echo "$cert_chain failed" >&2; return 1; }

	install -m 0600 -o root -g wheel "$cert_key_tmp" "$cert_key" && echo "$cert_key installed" || ok=false
	$ok || { echo "$cert_key failed" >&2; return 1; }

	echo "Certificate end date:"
	openssl x509 -in "$cert_chain" -enddate -noout | cut -d= -f2
}

renew_cert() {
	domain=$1
	test -n "$domain" || { echo "failed" >&2; return 1; }

	echo -n "$domain... "
	$ok && test "$(dig "$domain" A    +short)" == "$expected_a_record"    || ok=false
	$ok && test "$(dig "$domain" AAAA +short)" == "$expected_aaaa_record" || ok=false
	$ok && $(dig "$domain" CAA +short)                                    || ok=false
	$ok || { echo "failed" >&2; return 1; }

	acme-client "$domain"
	case $? in
		(0)		echo "revoked/renewed" ;;
		(1)		echo "failed" ;;
		(2)		echo "up-to-date" ;;
	esac
}

backup() {
	ok=true
	mnt=/mnt/beastie-box
	dump_dir=${mnt}/dump
	storage_box=u597578@u597578.your-storagebox.de

	echo "Making backups:"
	if [ ! -d "$dump_dir" ]
	then
		/usr/local/bin/sshfs "${storage_box}:" "$mnt" -p 23 || ok=false
		$ok || { echo "SSHFS mount failed" >&2; return 1; }
	fi

	weekday=$(date +%u)
	[ $weekday == 7 ] && n=0 || n=1
	for f in home var
	do
		dump -${n}uaf "${dump_dir}/${f}.dump.${weekday}" "/$f" 2> /dev/null || ok=false
		$ok || { echo "Dumping $f failed" >&2; return 1; }
	done
	echo "Done"
}

backup
echo
fetch_cert blip.town
echo
fetch_cert bliptown-staging.com
echo

echo "Renewing user certificates:"
grep "^domain" /etc/acme-domains.conf | cut -d' ' -f2 | while read -r domain
do
	renew_cert $domain
done
echo

echo "Restarting relayd:"
rcctl restart relayd
echo

echo "Expunging database dead tokens:"
ok=true
now=$(date +%s)
/usr/local/bin/sqlite3 /var/db/bliptown/users.db "DELETE FROM login_tokens WHERE expires < $now" || ok=false
/usr/local/bin/sqlite3 /var/db/bliptown/users.db "DELETE FROM logout_tokens WHERE expires < $now" || ok=false
$ok && echo "Done" || echo "Failed"
echo

echo "Checking database integrity:"
/usr/local/bin/sqlite3 /var/db/bliptown/users.db "PRAGMA integrity_check"
echo

echo "Creating database backup:"
ok=true
date=$(date +%F)
backup_db="/var/db/bliptown/users-${date}.db"
install -m 0600 -o root -g wheel /dev/null "$backup_db"
/usr/local/bin/sqlite3 /var/db/bliptown/users.db ".backup $backup_db" || ok=false
$ok && echo "Done" || echo "Failed"
echo

echo "Copying database to staging:"
ok=true
staging_db="/var/db/bliptown-staging/users.db"
/usr/local/bin/sqlite3 /var/db/bliptown/users.db ".backup $staging_db" || ok=false
$ok && echo "Done" || echo "Failed"
echo

echo "Flushing rate-limited IPs:"
ok=true
pfctl -q -t rate_limit -T expire 86400 || ok=false
$ok && echo "Done" || echo "Failed"
