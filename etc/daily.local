# -*- mode: sh; -*-
cleanup() {
	rm -f $tmpfiles
}
trap cleanup EXIT

renew_cert() {
	domain=$1
	wildcard=${2:-false}
	test -n "$domain" || return 1
	ok=true

	expected_A_record=46.225.163.173
	expected_AAAA_record=2a01:4f8:1c19:6498::1

	echo -n "$domain... "
	$ok && test "$(dig "$domain" A    +short)" = "$expected_A_record"    || ok=false
	$ok && test "$(dig "$domain" AAAA +short)" = "$expected_AAAA_record" || ok=false
	$ok || { echo "failed" >&2; return 1; }

	if $wildcard
	then
		hook=/usr/local/www/bliptown/bin/nsupdate.sh
		subdomain="*.$domain"
	else
		hook=/usr/pkg/libexec/uacme/uacme.sh
		subdomain="www.$domain"
	fi
	/usr/pkg/bin/uacme -c /etc/ssl -h "$hook" issue "$domain" "$subdomain"
	case $? in
		(0)		echo "issued new certificate" ;;
		(1)		echo "still current" ;;
		(2)		echo "failed" ;;
	esac

	chown -R :nginx "/etc/ssl/private/${domain}"
	chmod -R g+r "/etc/ssl/private/${domain}"
	chmod g+x "/etc/ssl/private/${domain}"
}

backup() {
	ok=true
	checksum_dir=/root/dump_checksums
	mnt=/mnt/box
	dump_dir=dumps
	storage_box=u597578@u597578.your-storagebox.de

	echo "Making backups:"

	mkdir -p "$checksum_dir"

	weekday=$(date +%u)
	monthday=$(date +%e)

	if [ $monthday = 1 ]
	then
		backup_type="monthly"
		dump_level=0
	elif [ $weekday = 7 ]
	then
		 backup_type="weekly"
		 dump_level=0
	else
		backup_type="daily"
		dump_level=1
	fi
	
	for d in home var
	do
		dump="${d}-$(date +%F).dump"
		fifo="/tmp/${dump}.fifo"
		tmpfiles="$fifo $tmpfiles"

		mkfifo "$fifo"
		md5 < "$fifo" > "$checksum_dir/${dump}.md5" &

		dump -${dump_level}uaf - "/$d" 2>/dev/null | tee "$fifo" |
			ssh -p23 "$storage_box" "dd of=${dump_dir}/${backup_type}/${dump}" || ok=false
		$ok || { echo "Dumping $d failed" >&2; return 1; }

		local_checksum=$(cat "$checksum_dir/${dump}.md5")
		remote_checksum=$(ssh -p23 "$storage_box" "md5 -r ${dump_dir}/${backup_type}/${dump}" | cut -d''  -f1)
		[ "$local_checksum" = "$remote_checksum" ] || ok=false
		$ok || { echo "Dump $dump checksum does not match" >&2; return 1; }
	done

	echo "Done"

	ok=true
	echo "Deleting old backups:"

	mount_psshfs -O Port=22 "${storage_box}:" "$mnt"

	find "${mnt}/${dump_dir}/daily" -name "*.dump" -mtime +7 -delete || ok=false
	find "${mnt}/${dump_dir}/weekly" -name "*.dump" -mtime +30 -delete || ok=false
	find "${mnt}/${dump_dir}/monthly" -name "*.dump" -mtime +365 -delete || ok=false

	umount "$mnt"
	$ok || { echo "Failed" >&2; return 1; }
	echo "Done"
}

backup
echo

echo "Renewing certificates:"
renew_cert blip.town true
renew_cert staging-blip.town true

ls /home/bliptown/domains | while read -r domain
do
	renew_cert $domain
done
echo

echo "Expunging database dead tokens:"
ok=true
now=$(date +%s)
/usr/bin/sqlite3 /var/db/bliptown/users.db "DELETE FROM login_tokens WHERE expires < $now" || ok=false
$ok && echo "Done" || echo "Failed"
echo

echo "Checking database integrity:"
ok=true
/usr/pkg/bin/sqlite3 /var/db/bliptown/users.db "PRAGMA integrity_check" >/dev/null || ok=false
$ok && echo "Done" || echo "Failed"
echo

echo "Creating database backup:"
ok=true
date=$(date +%F)
backup_db="/var/db/bliptown/users-${date}.db.backup"
install -m 0600 -o root -g wheel /dev/null "$backup_db"
/usr/pkg/bin/sqlite3 /var/db/bliptown/users.db ".backup $backup_db" || ok=false
$ok && echo "Done" || echo "Failed"
echo

echo "Deleting old database backups:"
ok=true
find /var/db/bliptown -name '*.db.backup' -mtime +30 -delete || ok=false
$ok && echo "Done" || echo "Failed"
echo

echo "Blocking malicious IPs:"
ok=true
/usr/local/www/bliptown/bin/npf-badhost || ok=false
$ok && echo "Done" || echo "Failed"
echo
