# -*- mode: sh; -*-
umask 0077;

. /home/bliptown/.envrc

visitor_log="/var/log/bliptown/visitor.log"
test -f "$visitor_log" || touch "$visitor_log"

gzcat -f "$visitor_log"* | /usr/local/www/bliptown/bin/bliptown_analytics

newsyslog

rate_limit_log="/var/log/rate_limit.log"
test -f "$rate_limit_log" || touch "$rate_limit_log"
now=$(date +%s)
cutoff=$(( now - 86400 ))
tmpfile=$(mktemp)

while read -r time ip
do
    [ -n "$ip" ] || continue

    if [ "$time" -lt "$cutoff" ]
	then
        npfctl table rate_limit rem $ip >/dev/null 2>&1
    else
        echo "$time $ip" >> "$tmpfile"
    fi
done < "$rate_limit_log"

mv "$tmpfile" "$rate_limit_log"
