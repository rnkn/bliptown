# -*- mode: sh; -*-

rate_limit_log="/var/log/rate_limit.log"
now=$(date +%s)
cutoff=$(( now - 86400 ))
tmpfile=$(mktemp)

while read -r ip time
do
    [ -n "$ip" ] || continue

    if [ "$time" -lt "$cutoff" ]
	then
        npfctl table rate_limit rem $ip 2>/dev/null
    else
        echo "$time $ip" >> "$tmpfile"
    fi
done < "$rate_limit_logfile"

mv "$tmpfile" "$rate_limit_log"
