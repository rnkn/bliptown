# -*- mode: sh; -*-
geolite2_endpoint="https://${MAXMIND_ID}:${MAXMIND_KEY}@download.maxmind.com/geoip/databases/GeoLite2-Country/download?suffix=tar.gz"
bunnycdn_endpoint="https://bunnycdn.com/api/system/edgeserverlist/plain"
bunnycdn_ipv6_endpoint="https://bunnycdn.com/api/system/edgeserverlist/IPv6/plain"

echo "Fetching GeoLite2 database:"
ok=true
ftp -Vo /tmp/geolite2-country.tar.gz "$geolite2_endpoint" || ok=false
if $ok
then
	tar -C /var/db/GeoIP -xzf /tmp/geolite2-country.tar.gz
	mv /var/db/GeoIP/GeoLite2-Country_*/*.mmdb \
	   /var/db/GeoIP/geolite2-country-current.mmdb
	rm -rf /var/db/GeoIP/GeoLite2-Country_*
	echo "Done"
else
	echo "Failed"
fi

if $ok
then
	echo "Restarting Bliptown:"
	rcctl restart bliptown_staging bliptown
fi
echo

echo "Fetching Bunny CDN IPs:"
ok=true
ftp -Vo /etc/bunnycdn.txt "$bunnycdn_endpoint" || ok=false
ftp -Vo /etc/bunnycdn-ipv6.txt "$bunnycdn_ipv6_endpoint" || ok=false
if $ok
then
	echo "Done"
	echo "Reloading pf:"
	pfctl -f /etc/pf.conf
	echo "Done"
else
	echo "Failed"
fi
