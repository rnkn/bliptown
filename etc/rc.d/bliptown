#!/bin/sh

# PROVIDE: bliptown
# REQUIRE: LOGIN
# KEYWORD: shutdown

$_rc_subr_loaded . /etc/rc.subr

name="bliptown"
rcvar=$name
pidfile="/tmp/${name}.pid"
command="/usr/pkg/bin/perl"
command_args="-Ilocal/lib/perl5 script/bliptown prefork -p -m production -l http://127.0.0.1:8080 -P $pidfile 2>&1 | /usr/bin/logger -t bliptown -p local0.notice &"
start_precmd=". /home/bliptown/.envrc"
bliptown_user=$name
bliptown_chdir="/usr/local/www/bliptown"
sig_stop="QUIT"

load_rc_config $name
run_rc_command "$1"
