#!/bin/sh

# PROVIDE: bliptown_staging
# REQUIRE: LOGIN inetd
# KEYWORD: shutdown

$_rc_subr_loaded . /etc/rc.subr

name="bliptown_staging"
rcvar=$name
pidfile="/tmp/${name}.pid"
logfile="/var/log/bliptown-staging/info.log"
errfile="/var/log/bliptown-staging/error.log"
command="/usr/pkg/bin/perl"
command_args="-Ilocal/lib/perl5 script/bliptown prefork -p -m production -l http://127.0.0.1:8081 -P $pidfile 1>$logfile 2>$errfile &"
start_precmd=". /home/bliptown-staging/.envrc"
bliptown_staging_user=$name
bliptown_staging_chdir="/usr/local/www/bliptown-staging"
sig_stop="QUIT"

load_rc_config $name
run_rc_command "$1"
