% layout 'default';
% my $disabled = $locked ? 'disabled' : '';
<nav>
	<header>
		<h1><%= $page_title %></h1>
	</header>
	<menu>
		<ul>
			<li><a href="/" class="exit">View Site</a>
		</ul>
	</menu>
</nav>
<main id="settings" class="backstage">
	<div class="one-column">
		<form method="POST" action="<%= url_for('save_settings') %>">
			<ul class="table">
				<li class="row">
					<label class="cell name" for="username">Username (cannot be changed)</label>
					<input class="cell" id="username" type="text" name="username" value="<%= $username %>" disabled>
				</li>
				<li class="row">
					<label class="cell name" for="email">Email</label>
					<input class="cell" id="email" type="email" name="email" value="<%= $email %>" <%= $disabled %>>
				</li>
				<li class="row">
					<span>
						<a href="<%= url_for('edit_page', catchall => '_domain.txt' )->query(back_to => url_for)%>">Custom domain</a>
						<a href="https://blip.town/faq/custom_domain" target="_blank" class="help-q">?</a>
					</span>
				</li>
				<li class="row">
					<span>
						<a href="<%= url_for('edit_page', catchall => '_pubkeys.txt' )->query(back_to => url_for)%>">SSH public keys</a>
						<a href="https://blip.town/faq/shell_access" target="_blank" class="help-q">?</a>
					</span>
				</li>
				<hr>
				<li class="row">
					<label for="create-backups" class="cell name">Automatically create backups (e.g. <code>file.md~</code>)</label>
					<input type="checkbox" class="right" id="create-backups" name="create_backups" value="1" <%= 'checked' if $create_backups == 1 %>>
				</li>
				<hr>
				% unless($locked) {
				<li class="row">
					<a href="<%= $billing_portal_url %>" target="_blank">Manage subscription and payment details</a>
				</li>
				% }
				<details id="delete-account">
					<summary class="row">Delete account</summary>
					<li class="row">
						<label class="cell name" for="delete-account-confirm">Automatic account deletion is not implemented during the alpha stage. Please contact <a href="mailto:support@blip.town">support@blip.town</a> to delete your account.</code></label>
					</li>
				</details>
			</ul>
			<hr>
			<button type="submit" <%= $disabled %>>Submit</button>
		</form>
	</div>
</main>
