% layout 'default';
<nav>
	<header>
		%== $header
	</header>
	<menu>
		%== $menu
		% if ($req_username eq 'mayor' && ! $c->session('username')) {
		<ul>
			<li><label for="drawer-toggle">Join/Login</label>
		</ul>
		% }
	</menu>
	<footer>
		%== $footer
	</footer>
</nav>
<main>
	%== $content
</main>
