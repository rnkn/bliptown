% layout 'default';
% my $req_username = get_req_username() // '';
<nav>
	<header>
		%== $header
	</header>
	<menu>
		%== $menu
		% if ($req_username eq 'mayor' && ! session('username')) {
		<ul>
			<li><label for="drawer-toggle">Join/Login</label>
		</ul>
		% }
	</menu>
	<footer>
		%== $footer
	</footer>
</nav>
<main>
	%== $content
</main>
<div id="analytics" data-track-url="<%= url_for('track_visit')->query(ref => $c->req->headers->referrer) %>"></div>
