% my $username = session('username') // '';
% my $req_username = get_req_username() // '';
% my $drawer_toggle_style = param('toggle') ? 'display: block' : '';
<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<title><%= $site_title %> &ndash; <%= $page_title %></title>
		<meta name="description" content="<%= $description %>">
		<meta name="author" content="<%= $author %>">
		<meta name="generator" content="Bliptown">
		<link href="/main.css" rel="stylesheet">
		<link rel="icon" type="image/png" sizes="128x128" href="/favicon.png" />
		<link rel="icon" type="image/x-icon" sizes="32x32" href="/favicon.ico" />
		% if ($customize) {
		<link href="/style.css?theme=<%= $theme %>" rel="stylesheet" sandbox>
		% foreach my $url (@$scripts) {
		<script src="<%= $url %>" defer></script>
		% }
		% }
		<script src="/main.js" defer></script>
	</head>
	<body>
		<input type="radio" id="drawer-switch-join" name="drawer-switch" hidden>
		<input type="radio" id="drawer-switch-login" name="drawer-switch" hidden checked>
		<input type="checkbox" id="drawer-toggle" hidden>
		<div id="drawer">
			% if ($username) {
			<div id="user" class="panel">
				<ul>
					% if ($username && $username eq $req_username) {
					<li><a href="<%= url_for('new_page', catchall => '')->query(back_to => $redirect) %>">New</a></li>
					% if ($editable) {
					<li><a href="<%= url_for('edit_page', catchall => get_slug)->query(back_to => $redirect) %>">Edit</a></li>
					% }
					<li><a href="<%= url_for('list_files', catchall => '') %>">Files</a></li>
					<li><a href="/style">Style</a></li>
					<li><a href="/private/stats">Stats</a></li>
					<li><a href="<%= url_for('list_settings') %>">Settings</a></li>
					% } else {
					<li><a href="<%= url_for('my_site') %>" id="my-site">My Site</a></li>
					% }
					<li><a href="https://blip.town/faq">Help</a></li>
					<li>
						<form id="logout" method="POST" action="<%= url_for('generate_logout')->query(back_to => url_for) %>">
							<button type="submit">Logout</button>
						</form>
					</li>
				</ul>
			</div>
			% } else {
			<div id="join" class="panel">
				<form id="join-credentials" method="POST" action="<%= url_for('user_join')->query(back_to => url_for) %>">
					<input type="text" placeholder="username" pattern="[a-zA-Z][a-zA-Z0-9_\-]*" name="username" maxlength="31" required disabled>
					<input type="email" placeholder="email" name="email" maxlength="254" required disabled>
					<button type="submit" disabled>Join</button>
				</form>
				<label id="drawer-switch-login" class="switch" for="drawer-switch-login">Login</label>
			</div>
			<div id="login" class="panel">
				% if ($req_username eq 'mayor') {
				<label id="drawer-switch-join" class="switch" for="drawer-switch-join">Join</label>
				% }
				<form id="login-credentials" method="POST" action="<%= url_for('generate_login')->query(back_to => url_for) %>">
					<input type="text" placeholder="username" name="username" required>
					<button type="submit">Login</button>
				</form>
			</div>
			% }
		</div>
		<div id="viewport">
			<input type="checkbox" id="nav-toggle" hidden>
			<label id="nav-toggle" class="button" for="nav-toggle"></label>
			<label id="drawer-toggle" class="button" for="drawer-toggle" style="<%= $drawer_toggle_style %>">+</label>
			%= content
			% if (flash('info')) {
			<dialog id="toast" open>
				<p><%= flash('info') %></p>
			</dialog>
			% }
		</div>
	</body>
</html>
