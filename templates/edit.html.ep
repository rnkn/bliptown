% layout 'default';
<nav class="backstage">
	<header>
		<h1><%= $page_title %></h1>
	</header>
	<menu>
		<ul>
			<li><a href="/" class="exit">View Site</a>
			<li><a href="<%= url_for('list_files', catchall => '') %>" class="exit">Files</a>
		</ul>
	</menu>
</nav>
<main id="edit" class="backstage">
	<section class="one-column">
		<form method="POST" action="<%= url_for('save_page')->query(back_to => $redirect) %>">
			<input type="hidden" name="csrf_token" value="<%= csrf_token %>">
			<div id="filename">
				<input type="text" name="slug" value="<%= $slug %>" required>
				<select id="ext" name="ext">
					% foreach my $render_ext (@{$c->app->config->{render_exts}}) {
					<option value="<%= $render_ext %>" <%= 'selected' if $ext eq $render_ext %>><%= ".$render_ext" %></option>
					% }
				</select>
				% if (current_route eq 'edit_page') {
				<a class="view-page" href="/<%= $slug %>" target="_blank">View Page</a>
				% }
			</div>
			<textarea id="content" name="content"><%= $content %></textarea>
			% if (@$includes) {
			<div id="includes">
				<strong>Includes:</strong>
				% foreach my $include (@$includes) {
				% my $rel_include = $include =~ s{^/}{}r;
				<a href="<%= url_for('edit_page', catchall => $rel_include)->query(back_to => $redirect) %>"><%= $include %></a>
				% }
			</div>
			% }
			<div id="controls">
				<button type="submit">Save</button>
				<a href="<%= param('back_to') || '/' %>">Cancel</a>
				<a href="https://blip.town/faq/editing" target="_blank" class="help-q">?</a>
			</div>
		</form>
	</section>
</main>
