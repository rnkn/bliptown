% layout 'default';
<nav>
	<header>
		<h1>
			% if (current_route eq 'new_page') {
			<%= $title %>
			% } elsif (current_route eq 'edit_page') {
			<%= $title %>
			% if ($slug =~ /^_/) {
			<%= $slug %>
			% } else {
			<a href="/<%= $slug %>"><%= $slug %></a>
			% }
			% }
		</h1>
	</header>
	<menu>
		<ul>
			<li><a href="/" class="exit">View Site</a>
			<li><a href="<%= url_for('list_files', catchall => '') %>" class="exit">Files</a>
		</ul>
	</menu>
</nav>
<main id="edit" class="backstage">
	<section class="one-column">
		<form method="post" action="<%= url_for('edit_page')->query(back_to => $redirect) %>">
			<div id="filename">
				<input type="text" name="slug" value="<%= $slug %>" required>
				<select id="ext" name="ext">
					% foreach my $allowed_ext (@{$c->config->{allowed_exts}}) {
					<option value="<%= $allowed_ext %>" <%= 'selected' if $ext eq $allowed_ext %>><%= ".$allowed_ext" %></option>
					% }
				</select>
			</div>
			<textarea name="content"><%= $content %></textarea>
			% if (@$includes) {
			<div id="includes">
				<strong>Includes:</strong>
				% foreach my $include (@$includes) {
				% my $rel_include = $include =~ s{^/}{}r;
				<a href="<%= url_for('edit_page', catchall => $rel_include)->query(back_to => $redirect) %>"><%= $include %></a>
				% }
			</div>
			% }
			<div id="controls">
				<input name="back_to" value="<%= $redirect %>" hidden>
				<button type="submit" name="action" value="save">Save</button>
				<button type="submit" name="action" value="save-exit">Save & Exit</button>
				<a href="<%= param('back_to') || '/' %>">Cancel</a>
				<a href="https://blip.town/faq/editing" class="help-q">?</a>
			</div>
		</form>
	</section>
</main>
