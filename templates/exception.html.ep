% layout 'default';
<nav>
	<header>
		<h1>Bliptown</h1>
	</header>
	<menu>
		<p><a href="/" class="exit">Home</a></p>
	</menu>
</nav>
<main class="one-column">
	<p>500 Internal Server Error</p>
	<p>
		Something went wrong, but don&rsquo;t worry, support has been
		notified and will be looking into it!
