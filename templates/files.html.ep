% layout 'default';
% my $disabled = $locked ? 'disabled' : '';
% my $render_exts_re = join '|', @{$c->app->config->{render_exts}};
<nav>
	<header>
		<h1><%= $page_title %></h1>
	</header>
	<menu>
		<p>
			<small>Search by filename to rename/delete multiple files at once.</small>
		</p>
		<div id="file-controls">
			<form id="search" method="GET" action="<%= url_for('list_files') %>">
				<input type="text" name="search" placeholder="glob" value="<%= param('search') %>">
			</form>
			% my $search_results = 'checked' if param('search');
			<input type="checkbox" id="additional-controls-toggle" hidden <%= $search_results %>>
			<fieldset id="search-controls">
				<button type="submit" form="search">Search</button>
				% if (param('search')) {
				<a href="<%= url_for('list_files') %>">Reset</a>
				% }
				<label id="additional-controls-toggle" class="button" for="additional-controls-toggle">+ more</label>
			</fieldset>
			<div id="additional-controls" class="controls">
				% if (param('search')) {
				<form id="replace" method="POST" action="<%= url_for('rename_files')->query(dir => $dir, old => param('search'), back_to => url_for->query(search => param('new'))) %>">
					<input type="hidden" name="csrf_token" value="<%= csrf_token %>">
					<input type="text" name="new" placeholder="string" value="<%= param('new') %>">
					<button type="submit">Replace Match in Filenames</button>
				</form>
				<button popovertarget="delete-files-popover">Delete Matching Files</button>
				<dialog id="delete-files-popover" class="modal" popover>
					<p>Really delete all matching files?</p>
					<form id="delete" method="POST" action="<%= url_for('delete_files')->query(dir => $dir, filenames => param('search')) %>">
						<input type="hidden" name="csrf_token" value="<%= csrf_token %>">
						<button type="submit" class="warning">Delete</button>
					</form>
				</dialog>
				% }
				<form id="download" method="POST" action="<%= url_for('download_site') %>">
					<input type="hidden" name="csrf_token" value="<%= csrf_token %>">
					<button type="submit">Download Site</button>
				</form>
			</div>
		</div>
		<ul>
			<li><a href="/" class="exit">View Site</a>
		</ul>
	</menu>
</nav>
<main id="files" class="backstage">
	<section class="one-column">
		<div id="breadcrumbs">
			<input type="checkbox" id="current-directory-controls-toggle" hidden>
			<span class="directories">
				<a href="<%= url_for('list_files', catchall => '') %>">home</a> /
				% foreach my $crumb (@$breadcrumbs) {
				<a href="<%= url_for('list_files', catchall => $crumb->{dirnames}) %>"><%= $crumb->{dirname} %></a> /
			</span>
			% }
			<label id="current-directory-controls-toggle" for="current-directory-controls-toggle">+</label>
			<div id="current-directory-controls" class="controls">
				<button popovertarget="new-file-popover">New File</button>
				<dialog id="new-file-popover" class="modal" popover>
					<form id="new-file" method="POST" action="<%= url_for('new_file')->query(dir => $dir, back_to => url_for) %>">
						<input type="hidden" name="csrf_token" value="<%= csrf_token %>">
						<input type="text" name="name">
						<select id="ext" name="ext">
							% foreach my $render_ext (@{$c->app->config->{render_exts}}) {
							<option value="<%= $render_ext %>" <%= 'selected' if $ext eq $render_ext %>><%= ".$render_ext" %></option>
							% }
						</select>
						<button type="submit">Create File</button>
					</form>
				</dialog>
				<button popovertarget="new-directory-popover">New Directory</button>
				<dialog id="new-directory-popover" class="modal" popover>
					<form id="new-directory" method="POST" action="<%= url_for('new_directory')->query(dir => $dir, back_to => url_for) %>">
						<input type="hidden" name="csrf_token" value="<%= csrf_token %>">
						<input type="text" name="name">
						<button type="submit">Create Directory</button>
					</form>
				</dialog>
				<button popovertarget="upload-popover">Upload Files</button>
				<dialog id="upload-popover" class="modal" popover>
					<form id="upload" method="POST" action="<%= url_for('upload_files')->query(dir => $dir, back_to => url_for) %>" enctype="multipart/form-data">
						<input type="hidden" name="csrf_token" value="<%= csrf_token %>">
						<input type="file" accept="text/*,image/*,audio/*,video/*,font/*,application/pdf,application/zip,application/gzip"
							   id="file-uploads" name="file-uploadss" multiple <%= $disabled %>>
						<button type="submit" <%= $disabled %>>Upload</button>
					</form>
				</dialog>
			</div>
		</div>
		<div id="list" class="table">
			% if (scalar @$files) {
			<div class="row">
				<a href="<%= url_with->query({ sort => 'name' }) %>" class="cell sort name">&vee;</a>
				<a href="<%= url_with->query({ sort => 'size' }) %>" class="cell sort size">&vee;</a>
				<a href="<%= url_with->query({ sort => 'date' }) %>" class="cell sort date">&vee;</a>
			</div>
			% }
			% foreach my $file (@$files) {
			<details name="files">
				<summary class="row">
					<span class="cell name">
						% if ($file->{is_dir}) {
						<a href="<%= url_for('list_files', catchall => $file->{abs_filename}) %>"><%= $file->{rel_filename} %></a>/
						% } else {
						<a href="<%= url_for('render_page', catchall => $file->{url}) %>"><%= $file->{rel_filename} %></a>
						% }
					</span>
					<span class="cell size">
						%= $file->{size}
					</span>
					<span class="cell date">
						%= $file->{mtime}
					</span>
				</summary>
				<ul class="controls">
					% unless ($file->{is_dir}) {
					<li><a href="<%= url_for('render_page', catchall => $file->{url}) %>">View</a></li>
					% }
					% if ($file->{rel_filename} =~ /\.($render_exts_re)$/) {
					<li><a href="<%= url_for('edit_page', catchall => $file->{url})->query(back_to => url_for) %>">Edit</a></li>
					% }
					% if ($file->{rel_filename} =~ /\.($render_exts_re)~?$/) {
					<li><a href="<%= url_for('render_raw', catchall => $file->{url}) %>">Raw</a></li>
					% }
					<li>
						<form method="POST" action="<%= url_for('backup_file')->query(filename => $file->{abs_filename}, back_to => url_with) %>">
							<input type="hidden" name="csrf_token" value="<%= csrf_token %>">
							<button type="submit">Backup</button>
						</form>
					</li>
					<li>
						<button popovertarget="rename-popover-<%= $file->{rel_filename} %>">Rename</button>
						<dialog id="rename-popover-<%= $file->{rel_filename} %>" class="modal" popover>
							<form method="POST" action="<%= url_for('rename_files')->query(old => $file->{abs_filename}, back_to => url_with) %>">
								<input type="hidden" name="csrf_token" value="<%= csrf_token %>">
								<input type="text" name="new" value="<%= $file->{abs_filename} %>">
								<button type="submit">Rename</button>
							</form>
						</dialog>
					</li>
					<li>
						<button popovertarget="delete-popover-<%= $file->{rel_filename} %>">Delete</button>
						<dialog id="delete-popover-<%= $file->{rel_filename} %>" class="modal" popover>
							% if ($file->{is_dir}) {
							<p>Really delete this directory and all of its contents?</p>
							<pre><%= $file->{rel_filename} %>/</pre>
							% } else {
							<p>Really delete this file?</p>
							<pre><%= $file->{rel_filename} %></pre>
							% }
							<form method="POST" action="<%= url_for('delete_files')->query(filenames => $file->{abs_filename}, back_to => url_with) %>">
								<input type="hidden" name="csrf_token" value="<%= csrf_token %>">
								<button type="submit" class="warning">Delete</button>
							</form>
						</dialog>
					</li>
				</ul>
			</details>
			% }
		</div>
	</section>
</main>
