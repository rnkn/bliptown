% layout 'default';
% my $disabled = $locked ? 'disabled' : '';
<nav>
	<header>
		<h1><%= $title %></h1>
	</header>
	<menu>
		<p>
			<small>
				Search by filename to rename/delete multiple files at
				once. Deleting a file will remove it immediately.
			</small>
		</p>
		<div id="controls">
			<form id="search" method="get" action="<%= url_for('list_files') %>">
				<input type="text" name="search" placeholder="glob" value="<%= param('search') %>">
			</form>
			% my $search_results = 'checked' if param('search');
			<input type="checkbox" id="additional-controls-toggle" hidden <%= $search_results %>>
			<fieldset id="search-controls">
				<button type="submit" form="search">Search</button>
				% if (param('search')) {
				<a href="<%= url_for('list_files') %>">Reset</a>
				% }
				<label id="additional-controls-toggle" class="button" for="additional-controls-toggle">+ more</label>
			</fieldset>
			<div id="additional-controls">
				% if (param('search')) {
				<form id="replace" method="get" action="<%= url_for('list_files')%>">
					<input type="hidden" name="search" value="<%= param('search') %>">
					<input type="text" name="replace" placeholder="string" value="<%= param('replace') %>">
					<button type="submit">Replace Match in Filenames</button>
				</form>
				<form id="delete" method="get" action="<%= url_for('list_files')%>">
					<input type="hidden" name="search" value="<%= param('search') %>">
					<button type="submit" name="delete" value="1">Delete Matching Files</button>
				</form>
				% }
				<form id="upload" method="post" action="<%= url_for('upload_files') %>" enctype="multipart/form-data">
					<input type="file" accept="text/*,image/*,application/pdf" id="file-uploads" name="file-uploads" multiple <%= $disabled %>>
					<button type="submit" <%= $disabled %>>Upload</button>
				</form>
				<form id="snapshot" method="get" action="<%= url_for('take_snapshot') %>">
					<button type="submit">Take Snapshot</button>
					<small><a href="<%= url_for('list_snapshots') %>">Browse Snapshots</a></small>
				</form>
			</div>
		</div>
		<ul>
			<li><a href="/" class="exit">View Site</a>
		</ul>
	</menu>
</nav>
<main id="files">
	<section class="one-column">
		<div id="breadcrumbs">
			<input type="checkbox" id="create-directory-toggle" hidden>
			<a href="<%= url_for('list_files', catchall => '') %>">home</a> /
			% foreach my $crumb (@$breadcrumbs) {
			<a href="<%= url_for('list_files', catchall => $crumb->{path}) %>"><%= $crumb->{name} %></a> /
			% }
			<label id="create-directory-toggle" for="create-directory-toggle">+</label>
			<div id="create-directory-controls">
				<form id="create-directory" method="post" action="<%= url_for('file_action')->query(action => 'new_directory') %>">
					<input placeholder="directory" name="name">
					<button type="submit">Create</button>
				</form>
			</div>
		</div>
		<div id="list" class="table">
			% if (scalar @$files) {
			<div class="row">
				<a href="<%= url_with->query({ sort => 'name' }) %>" class="cell sort name">&vee;</a>
				<a href="<%= url_with->query({ sort => 'size' }) %>" class="cell sort size">&vee;</a>
				<a href="<%= url_with->query({ sort => 'date' }) %>" class="cell sort date">&vee;</a>
			</div>
			% }
			% foreach my $file (@$files) {
			<details name="files">
				<summary class="row">
					<span class="cell name">
						% if ($file->{is_dir}) {
						<a href="<%= url_for('list_files', catchall => $file->{abs_filename}) %>"><%= $file->{rel_filename} %></a>/
						% } else {
						<a href="<%= url_for('render_page', catchall => $file->{url}) %>"><%= $file->{rel_filename} %></a>
						% }
					</span>
					<span class="cell size">
						%= $file->{size}
					</span>
					<span class="cell date">
						%= $file->{mtime}
					</span>
				</summary>
				<ul class="controls">
					<li>
						<form id="rename" method="get" action="<%= url_for('rename_file', catchall => $file->{abs_filename}) %>">
							<input type="text" name="name" value="<%= $file->{abs_filename} %>">
							<input type="text" name="back_to" value="<%= url_for %>" hidden>
							<button type="submit">Rename</button>
						</form>
					</li>
					% if ($file->{rel_filename} =~ /\.(md|txt|html|css|js)$/) {
					<li><a href="<%= url_for('edit_page', catchall => $file->{url} )->query(back_to => url_for) %>">Edit</a></li>
					<li><a href="<%= url_for('backup_file', catchall => $file->{abs_filename} )->query(back_to => url_for) %>">Backup</a></li>
					% }
					% if ($file->{rel_filename} =~ /\.(md|txt|html|css|js)~?$/) {
					<li><a href="<%= url_for('render_raw', catchall => $file->{url} ) %>">Raw</a></li>
					% }
					<li><a class="warning" href="<%= url_for('delete_file', catchall => $file->{abs_filename} )->query(back_to => url_for)%>">Delete</a></li>
				</ul>
			</details>
			% }
		</div>
	</section>
</main>
