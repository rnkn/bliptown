% layout 'default';
<nav>
	<header>
		<h1><%= $page_title %></h1>
	</header>
	<menu>
		<p>
			<small>
				Restoring a snapshot will make the files available
				at <code>/snapshots/&lt;HASH&gt;</code>. Downloading a
				snapshot will retrieve a tarball containing the site
				files at the time of that snapshot.
			</small>
		</p>
		<ul>
			<li><a href="<%= url_for('list_files', catchall => '') %>" class="exit">Files</a>
			<li><a href="/" class="exit">View Site</a>
		</ul>
	</menu>
</nav>
<main id="snapshots" class="backstage">
	<section class="one-column">
		% if (@$snapshots) {
		<details id="clone" class="js-clipboard">
			<summary>
				<small>
					History limited to 50 commits. For full history, clone
					this repository.
				</small>
			</summary>
			<pre>git clone <%= $repo %></pre>
		</details>
		% }
		<div id="list" class="table">
			% foreach (@$snapshots) {
			<details name="snapshot">
				<summary class="row">
					<span class="cell commit hash"><code><%= $_->{hash} %></code></span>
					<span class="cell commit subject"><%= $_->{subject} %></span>
					<span class="cell commit date right"><%= $_->{date} %></span>
				</summary>
				<pre class="commit body"><%= $_->{body} || 'No commit message' %></pre>
				<ul class="controls">
					<li>
						<form method="POST" action="<%= url_for('restore_snapshot')->query(hash => $_->{hash}) %>">
							<input type="hidden" name="csrf_token" value="<%= csrf_token %>">
							<button type="submit">Restore</button>
						</form>
					</li>
					<li><a href="<%= url_for('download_snapshot', hash => $_->{hash}) %>">Download</a></li>
					<li><a href="<%= url_for('render_diff', hash => $_->{hash}) %>">Changes</a></li>
				</ul>
			</details>
			% }
		</div>
	</section>
</main>
