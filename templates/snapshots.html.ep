% layout 'default';
<nav>
	<header>
		<h1><%= $title %></h1>
	</header>
	<menu>
		<p>
			<small>
				Restoring a snapshot will make the files available
				at <code>/snapshots/&lt;HASH&gt;</code>. Downloading a
				snapshot will retrieve a tarball of the files of that
				snapshot.
			</small>
		</p>
		<ul>
			<li><a href="<%= url_for('list_files', catchall => '') %>" class="exit">Files</a>
			<li><a href="/" class="exit">View Site</a>
		</ul>
	</menu>
</nav>
<main id="snapshots" class="backstage">
	<section class="one-column">
		% if (@$snapshots) {
		<details id="clone">
			<summary>
				<small>
					History limited to 50 commits. For full history, clone
					this repository.
				</small>
			</summary>
			<pre>git clone <%= $repo %></pre>
		</details>
		% }
		<div id="list" class="table">
			% foreach (@$snapshots) {
			<details name="snapshot">
				<summary class="row">
					<span id="commit-hash" class="cell"><code><%= $_->{hash} %></code></span>
					<span id="commit-subject" class="cell"><%= $_->{subject} %></span>
					<span id="commit-date" class="cell right"><%= $_->{date} %></span>
				</summary>
				<pre id="commit-body"><%= $_->{body} || 'No commit message' %></pre>
				<ul class="controls">
					<li><a href="<%= url_for('restore_snapshot', hash => $_->{hash}) %>">Restore</a></li>
					<li><a href="<%= url_for('download_snapshot', hash => $_->{hash}) %>">Download</a></li>
					<li><a href="<%= url_for('render_diff', hash => $_->{hash}) %>">Changes</a></li>
				</ul>
			</details>
			% }
		</div>
	</section>
</main>
