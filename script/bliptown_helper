#!/usr/bin/env perl

use strict;
use warnings;
use File::Basename;
use constant DIR => dirname(__FILE__);
use lib DIR . '/../lib', DIR . '/../local/lib/perl5';

use IO::Socket::UNIX;
use POSIX qw(setgid setuid pause WNOHANG);
use Mojo::File qw(path tempfile);
use Mojo::Util qw(trim);
use Mojo::JSON qw(encode_json decode_json);

my $has_unveil = eval {
	require OpenBSD::Unveil;
	OpenBSD::Unveil->import;
	return 1;
};

my $has_pledge = eval {
	require OpenBSD::Pledge;
	OpenBSD::Pledge->import;
	return 1;
};

pledge(qw(rpath wpath cpath chown fattr unix proc id unveil exec))
	if $has_pledge;

die "$0 must be run as root"					unless $> == 0;

$0 = $0 . '[master]';

die 'BLIPTOWN_HELPER_SOCKET not defined'		unless defined $ENV{BLIPTOWN_HELPER_SOCKET};
die 'BLIPTOWN_HELPER_PREFORK not defined'		unless defined $ENV{BLIPTOWN_HELPER_PREFORK};
die 'BLIPTOWN_HELPER_HEALTH_FILE not defined'	unless defined $ENV{BLIPTOWN_HELPER_HEALTH_FILE};

die 'BLIPTOWN_DATA_HOME not defined'			unless defined $ENV{BLIPTOWN_DATA_HOME};
die 'BLIPTOWN_GID not defined'					unless defined $ENV{BLIPTOWN_GID};

die 'BLIPTOWN_KEYPAIR_FILE not defined '		unless defined $ENV{BLIPTOWN_KEYPAIR_FILE};
die 'BLIPTOWN_ACME_FILE not defined'			unless defined $ENV{BLIPTOWN_ACME_FILE};

my $prefork = $ENV{BLIPTOWN_HELPER_PREFORK} // 4;
my %children;
my $needs_reap;
my $shutdown;

my $health_file = path($ENV{BLIPTOWN_HELPER_HEALTH_FILE});
$health_file->remove->touch or die "Cannot create health file: $health_file\n";
print "Health file created: $health_file\n";

my $sock_file = path($ENV{BLIPTOWN_HELPER_SOCKET});
$sock_file->remove;

my $sock = IO::Socket::UNIX->new(
	Type => SOCK_STREAM,
	Local => $sock_file,
	Listen => 128,
) or die "Cannot create socket: $sock_file ($!)";

chown(0, $ENV{BLIPTOWN_GID}, $sock_file) or die "Cannot chown: $sock_file ($!)";
chmod(0660, $sock_file) or die "Cannot chmod: $sock_file ($!)";

print "Socket created: $sock_file\n";

my $safe_domain_regex = qr/^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$/;
my $safe_hash_regex = qr/^[0-9a-f]{7,40}$/;

sub update_acme_domains {
	my $payload = shift;
	my $domains = $payload->{domains};

	my $acme_file = path($ENV{BLIPTOWN_ACME_FILE});

	if ($has_unveil) {
		unveil($acme_file, 'rwc');
		unveil();
	}

	$acme_file->touch unless -f $acme_file;

	my @safe_domains = grep { /$safe_domain_regex/ } @$domains;

	my $acme_domains_str = '';
	foreach my $domain (@safe_domains) {
		$acme_domains_str .= <<"EOF";
domain $domain {
	alternative names { www.$domain }
	domain full chain certificate "/etc/ssl/$domain.crt"
	domain key "/etc/ssl/private/$domain.key"
	sign with "letsencrypt"
}
EOF
	}

	my $acme_file_str = $acme_file->slurp('UTF-8');
	unless ($acme_domains_str eq $acme_file_str) {
		$acme_file->spew($acme_domains_str, 'UTF-8');
	}
	return 'ACME domain list up-to-date';
}

sub provision_cert {
	my $payload = shift;
	my $domain = $payload->{domain};
	return unless $domain =~ $safe_domain_regex;
	system('acme-client', $domain);
	my $exit = $? >> 8;
	return "Provisioned certificate: $domain" if $exit == 0;
	return "Certificate already current: $domain" if $exit == 2;
	die "Cannot provision certificate: $domain ($!)";
}

sub update_relayd_keypairs {
	my $payload = shift;
	my $domains = $payload->{domains};

	my $keypair_file = path($ENV{BLIPTOWN_KEYPAIR_FILE});

	if ($has_unveil) {
		unveil($keypair_file, "rwc");
		unveil();
	}

	$keypair_file->touch unless -f $keypair_file;

	my @safe_domains = grep { /$safe_domain_regex/ } @$domains;

	my $keypairs_str = '';
	foreach my $domain (@safe_domains) {
		next unless -f path('/etc/ssl', "$domain.crt");
		$keypairs_str .= "tls keypair \"$domain\"\n";
	}

	my $keypair_file_str = $keypair_file->slurp('UTF-8');
	unless ($keypairs_str eq $keypair_file_str) {
		$keypair_file->spew($keypairs_str, 'UTF-8')
			or die "Cannot write keypair file: $keypair_file ($!)";

		system('rcctl reload relayd') == 0 or die "Cannot reload relayd ($!)";
	}
	return 'relayd keypairs up-to-date';
}

sub get_uid_gid {
	my $user = shift;
	my @pw = getpwnam($user) or die "Cannot find user: $user";
	my $uid = $pw[2];
	my $gid = $pw[3];
	return ($uid, $gid);
}

sub write_blob {
	my $payload = shift;
	my $filename = $payload->{filename};
	my $blob = $payload->{blob};
	my $path = path $filename;
	my $dir = $path->dirname;
	$dir->make_path or die "Cannot creat path: $dir ($!)";;
	$path->spew($blob) or die "Cannot write file: $path ($!)";
	return "Wrote file: $filename";
}

sub backup_file {
	my $payload = shift;
	my $filename = $payload->{filename};
	my $path = path $filename;
	$path->copy_to("${filename}~") or die "Cannot backup file: $path ($!)";
	return "Created backup file: ${filename}~"
}

sub update_file {
	my $payload = shift;
	my $filename = $payload->{filename};
	my $content = $payload->{content};
	my $path = path $filename;
	my $dir = $path->dirname;
	$dir->make_path or die "Cannot creat path: $dir ($!)";
	if ($payload->{create_backup} && -e $filename) {
		backup_file $payload;
	}
	$path->spew($content, 'UTF-8') or die "Cannot write file: $path ($!)";
	return "Updated file: $filename"
}

sub rename_file {
	my $payload = shift;
	my $filename = $payload->{filename};
	my $path = path $filename;
	my $new_filename = $payload->{new_filename};
	my $new_path = path $new_filename;
	if (-d $new_path && $new_path->list > 0) {
		return "Skipping nonempty directory: $new_path";
	}
	my $dir = $new_path->dirname;
	$dir->make_path or die "Cannot create path: $dir ($!)";
	$path->move_to($new_path) or die "Cannot move file: $path ($!)";
	return "Renamed file: $filename -> $new_filename";
}

sub delete_file {
	my $payload = shift;
	my $filename = $payload->{filename};
	if (-d $filename) {
		unlink glob("$filename/.*");
		rmdir $filename or die "Cannot delete directory: $filename ($!)";;
	} else {
		unlink $filename or die "Cannot delete file: $filename ($!)";
	}
	return "Deleted: $filename"
}

sub make_directory {
	my $payload = shift;
	my $dirname = $payload->{filename};
	my $path = path $dirname;
	$path->make_path or die "Cannot create directory: $dirname ($!)";
	return "Created directory: $dirname";
}

sub git_init {
	my $payload = shift;
	my $user = $payload->{system_user};
	my $worktree = path($ENV{BLIPTOWN_DATA_HOME}, 'users', $user);
	my $repo = path($ENV{BLIPTOWN_DATA_HOME}, 'repos', "$user.git");
	my $excludes_file = '/etc/gitignore';
	chdir $repo or die "Cannot change directory: $repo ($!)";

	system(qw(git init --bare -q)) == 0
		or die "Cannot initialize repository: $repo ($!)";
	system('git', 'config', 'set', 'user.name', $user) == 0
		or die "Cannot configure repository user name ($!)";
	system('git', 'config', 'set', 'user.email', "${user}\@blip.town") == 0
		or die "Cannot configure repository user email ($!)";
	system('git', 'config', 'set', 'core.excludesFile', $excludes_file) == 0
		or die "Cannot configure repository ignore file ($!)";

	my $post_update = <<"EOF";
#!/bin/sh
git --work-tree=$worktree reset --hard
EOF

	my $hook_path = path($repo, 'hooks', 'post-update');
	my $hook_file = Mojo::File->new($hook_path);

	unless (-f $hook_file) {
		$hook_file->spew($post_update, 'UTF-8');
		$hook_file->chmod(0755);
	}

	return "Initialized Git repository: $repo";
}

sub git_log {
	my $payload = shift;
	my $user = $payload->{system_user};
	my $repo = path($ENV{BLIPTOWN_DATA_HOME}, 'repos', "$user.git");
	chdir $repo or die "Cannot change directory: $repo ($!)";
	my $out = `git log --date=format:"%Y-%m-%d %H:%M %z" --pretty=format:"%h%x00%s%x00%ad%x00%b%x01" --max-count=50`;

	my @commits;
	foreach my $commit (split /\x01/, $out) {
		my $commit = trim $commit;
		my ($hash, $subject, $date, $body) = split(/\x00/, $commit, 4);
		push @commits, {
			hash => $hash,
			subject => $subject,
			date => $date,
			body => $body,
		};
	}
	return \@commits;
}

sub git_show {
	my $payload = shift;
	my $user = $payload->{system_user};
	my $hash = $payload->{hash};
	die "Invalid hash: $hash" unless $hash =~ $safe_hash_regex;
	my $repo = path($ENV{BLIPTOWN_DATA_HOME}, 'repos', "$user.git");
	chdir $repo or die "Cannot change directory: $repo ($!)";
	my $out = `git show $hash`;
	return unless length $out;
	return $out;
}

sub git_commit {
	my $payload = shift;
	my $user = $payload->{system_user};
	my $worktree = path($ENV{BLIPTOWN_DATA_HOME}, 'users', $user);
	my $repo = path($ENV{BLIPTOWN_DATA_HOME}, 'repos', "$user.git");
	git_init($payload);
	chdir $repo or die "Cannot change directory: $repo ($!)";

	system('git', "--work-tree=$worktree", 'add', '-A') == 0
		or die "Cannot add files to $repo";

	my $subject = 'Full snapshot on Bliptown';
	my $body = `git --work-tree=$worktree status --porcelain`;
	return unless length $body;

	system('git', "--work-tree=$worktree", 'commit', '-q', '-m', $subject, '-m', $body) == 0
		or die "Cannot commit files to repo: $repo ($!)";

	my $commits = git_log($payload);
	my $hash = $commits->[0]->{hash};
	return $hash;
}

sub git_checkout {
	my $payload = shift;
	my $user = $payload->{system_user};
	my $root = path($ENV{BLIPTOWN_DATA_HOME}, 'users', $user);
	my $hash = $payload->{hash};
	die "Invalid hash: $hash" unless $hash =~ $safe_hash_regex;
	my $dir = path($root, 'snapshots', $hash);
	$dir->make_path or die "Cannot make path: $dir ($!)";
	my $tarball = git_archive($payload);
	system('tar', '-xzf', $tarball, '-C', $dir) == 0
		or die "Failed to extract files from tarball ($!)";
	unlink $tarball;
	return $hash;
}

sub git_archive {
	my $payload = shift;
	my $user = $payload->{system_user};
	my $repo = path($ENV{BLIPTOWN_DATA_HOME}, 'repos', "$user.git");
	my $hash = $payload->{hash};
	die "Invalid hash: $hash" unless $hash =~ $safe_hash_regex;
	my $tmpfile = tempfile(UNLINK => 0);
	chmod(0644, $tmpfile);
	git_init($payload);
	chdir $repo or die "Cannot change directory: $repo ($!)";
	system('git', 'archive', '--format=tar.gz', '-o', $tmpfile, $hash) == 0
		or die "Failed to extract archive from hash: $hash ($!)";
	return $tmpfile->to_string;
}

my %allowed_commands = (
	write_blob				=> \&write_blob,
	update_file				=> \&update_file,
	rename_file				=> \&rename_file,
	delete_file				=> \&delete_file,
	backup_file				=> \&backup_file,
	make_directory			=> \&make_directory,
	git_commit				=> \&git_commit,
	git_log					=> \&git_log,
	git_show				=> \&git_show,
	git_checkout			=> \&git_checkout,
	git_archive				=> \&git_archive,
	provision_cert			=> \&provision_cert,
	update_acme_domains		=> \&update_acme_domains,
	update_relayd_keypairs	=> \&update_relayd_keypairs,
);

sub handle_conn {
	my $conn = shift;

	my $req_blob;
	while (read($conn, my $buf, 512)) {
		$req_blob .= $buf;
	}

	my $data = decode_json($req_blob);
	my $command = $data->{command};
	my $payload = $data->{payload};

	my ($res, $err);

	if ($has_unveil) {
		my @paths = split ':', $ENV{PATH};
		map { unveil($_, 'x') or die "Cannot unveil path: $_ ($!)" } @paths;
		unveil('/etc', 'r') or die "Cannot unveil path: /etc ($!)";
		unveil('/tmp', 'rwc') or die "Cannot unveil path: /tmp ($!)";
	}

	eval {
		my $user = $payload->{system_user};

		unless ($user eq 'root') {
			my ($uid, $gid) = get_uid_gid($user);

			setgid($gid) or die "Cannot set group: $gid ($!)";
			setuid($uid) or die "Cannot set user: $uid ($!)";

			if ($has_unveil) {
				my $root = path($ENV{BLIPTOWN_DATA_HOME}, 'users', $user);
				my $repo = path($ENV{BLIPTOWN_DATA_HOME}, 'repos', "$user.git");
				unveil($root, 'rwc') or die "Cannot unveil path: $root ($!)";
				unveil($repo, 'rwc') or die "Cannot unveil path: $repo ($!)";
				unveil();
			}
		}

		my $func = $allowed_commands{$command} or
			die "Command not permitted: $command";

		$res = $func->($payload);
	};
	$err = $@;

	my $res_blob = encode_json(
		{
			info => $res,
			error => $err,
		});

	$conn->send($res_blob) or warn "Cannot send response ($!)";
	return;
}

$SIG{CHLD} = sub { $needs_reap = 1 };
$SIG{TERM} = $SIG{INT} = sub { $shutdown = 1 };

sub spawn_worker {
	my $pid = fork;
	die "Cannot fork process ($!)" unless defined $pid;

	if ($pid == 0) {
		$0 =~ s/master/worker/;
		my $conn = $sock->accept;

		if (!$conn) {
			next if $!{EINTR} && !$shutdown;
			print "Worker $$ shutting down gracefully...\n";
			exit 0;
		}

		handle_conn $conn;
		$conn->close;
		exit 0;
	}

	$children{$pid} = 1;
}

sub reap_children {
	while ((my $pid = waitpid -1, WNOHANG) > 0) {
		delete $children{$pid};
	}
}

while (1) {
	if ($needs_reap) {
		reap_children;
		$needs_reap = 0;
	}

	if ($shutdown) {
		kill('TERM', keys %children);
		last;
	}

	while (keys %children < $prefork && !$shutdown) {
		spawn_worker;
	}

	my $ok = kill(0, keys %children);
	$health_file->spew($ok);

	while (!$needs_reap && !$shutdown) { pause }
}

while (%children) {
	reap_children;
	sleep 1;
}

print "Helper $$ exiting cleanly...\n";
exit 0;
