#!/bin/ksh

usage() {
	cat <<EOF
Available commands are:

sftp    upload, download and manage files
        https://man.openbsd.org/sftp.1

rsync   sync files between a local machine and the server
        https://man.openbsd.org/openrsync.1

git     version control files (snapshots)
        https://git-scm.com/
EOF
}

case "$SSH_ORIGINAL_COMMAND" in
	("")
		cat /etc/motd
		echo
		echo "Bliptown does not permit interactive shell login."
		echo
		usage
		echo
		;;
	(git*)
		exec git-shell -c "$SSH_ORIGINAL_COMMAND"
		;;
	(openrsync*)
		exec openrsync ${SSH_ORIGINAL_COMMAND#openrsync}
		;;
	(rsync*)
		exec openrsync ${SSH_ORIGINAL_COMMAND#rsync}
		;;
	(*)
		echo "Command not permitted"
		echo
		usage
		echo
		exit 1
		;;
esac
