#!/usr/bin/env perl

use strict;
use warnings;
use File::Basename;
use lib dirname(__FILE__) . '/../local/lib/perl5';

use Mojo::File qw(path tempfile);
use Mojo::Util qw(trim b64_decode);
use Mojo::JSON qw(decode_json encode_json);
use POSIX qw(setgid setuid);

die "$0 must be run as root" unless $> == 0;

my $envrc = shift @ARGV || "$ENV{HOME}/.envrc";
my @lines = split /\n/, path($envrc)->slurp;
foreach my $line (@lines) {
	next unless $line =~ /^export ([A-Za-z_][A-Za-z0-9_]*)=(.*)$/;
	my ($key, $val) = ($1, $2);
	$val = trim $val;
	$val =~ s/^"(.*)"$/$1/;
	$val =~ s{\$([A-Za-z_][A-Za-z0-9_]*)}{$ENV{$1} // ''}ge if $val;
	$ENV{$key} = $val;
}

die "BLIPTOWN_DATA_HOME not defined" unless defined $ENV{BLIPTOWN_DATA_HOME};

my $safe_hash_regex = qr/^[0-9a-f]{7,40}$/;

sub chdir_site {
	my $user = shift;
	my $site_path = path($ENV{BLIPTOWN_DATA_HOME}, 'users', $user);
	chdir $site_path or die "Cannot change directory: $site_path ($!)";
	return $site_path->to_string;
}

sub write_blob {
	my $payload = shift;
	my $home = chdir_site($payload->{system_user});
	my $filename = $payload->{filename};
	my $b64_encoded = $payload->{blob};
	my $blob = b64_decode($b64_encoded);
	my $path = path($filename);
	my $dir = $path->dirname;
	$dir->make_path or die "Cannot create path: $dir ($!)";;
	$path->spew($blob) or die "Cannot write file: $path ($!)";
	return "Wrote file: $filename";
}

sub backup_file {
	my $payload = shift;
	my $home = chdir_site($payload->{system_user});
	my $filename = $payload->{filename};
	my $path = path $filename;
	$path->copy_to("${filename}~") or die "Cannot backup file: $path ($!)";
	return "Created backup file: ${filename}~"
}

sub update_file {
	my $payload = shift;
	my $home = chdir_site($payload->{system_user});
	my $filename = $payload->{filename};
	my $content = $payload->{content};
	my $path = path $filename;
	my $dir = $path->dirname;
	$dir->make_path or die "Cannot create path: $dir ($!)";
	if ($payload->{create_backup} && -e $filename) {
		backup_file $payload;
	}
	$path->spew($content, 'UTF-8') or die "Cannot write file: $path ($!)";
	return "Updated file: $filename"
}

sub rename_files {
	my $payload = shift;
	my $home = chdir_site($payload->{system_user});
	my @messages;
	foreach my $rename (@{$payload->{filenames} // []}) {
		my $filename = $rename->{old};
		my $path = path $filename;
		my $new_filename = $rename->{new};
		my $new_path = path $new_filename;
		if (-d $new_path && $new_path->list > 0) {
			push @messages, "Skipping nonempty directory: $new_path";
			next;
		}
		my $dir = $new_path->dirname;
		$dir->make_path or die "Cannot create path: $dir ($!)";
		$path->move_to($new_path) or die "Cannot move file: $path ($!)";
		push @messages, "Renamed file: $filename -> $new_filename";
	}
	return join ', ', @messages;
}

sub delete_files {
	my $payload = shift;
	my $home = chdir_site($payload->{system_user});
	my @filenames = @{$payload->{filenames} // []};

	@filenames = sort { length $b <=> length $a } @filenames;

	my @deleted;
	foreach my $filename (@filenames) {
		if (-d $filename) {
			path($filename)->remove_tree or die "Cannot delete directory: $filename ($!)";
		}
		else {
			path($filename)->remove or die "Cannot delete file: $filename ($!)";
		}
		push @deleted, $filename;
	}
	return 'Deleted: ' . join ', ', @deleted;
}

sub make_directory {
	my $payload = shift;
	my $home = chdir_site($payload->{system_user});
	my $dir = $payload->{filename};
	path($dir)->make_path or die "Cannot create directory: $dir ($!)";
	return "Created directory: $dir";
}

sub download_site {
	my $payload = shift;
	my $username = $payload->{system_user};
	chdir_site($username);
	my $tmpfile = tempfile(UNLINK => 0)->chmod(0644);
	my $site_path = path($ENV{BLIPTOWN_DATA_HOME}, 'users', $username);
	my @tree = $site_path->list_tree->each;
	@tree = map { $_->to_rel($site_path) } @tree;
	system('tar', '-czf', $tmpfile, @tree) == 0
		or die "Failed to create tarball: ($!)";
	return $tmpfile->to_string;
}

my %allowed_commands = (
	write_blob		=> { func => \&write_blob,		fields => [qw(system_user filename blob)] },
	update_file		=> { func => \&update_file,		fields => [qw(system_user filename content)] },
	rename_files	=> { func => \&rename_files,	fields => [qw(system_user filenames)] },
	delete_files	=> { func => \&delete_files,	fields => [qw(system_user filenames)] },
	backup_file		=> { func => \&backup_file,		fields => [qw(system_user filename)] },
	make_directory	=> { func => \&make_directory,	fields => [qw(system_user filename)] },
	download_site	=> { func => \&download_site,	fields => [qw(system_user)] },
);

my $req_json;
while (read(STDIN, my $buf, 512)) {
	$req_json .= $buf;
}

my $data = decode_json($req_json);
my $command = $data->{command};
my $payload = $data->{payload};

my ($res, $err);

open(STDERR, '>', '/dev/null');

eval {
	my $spec = $allowed_commands{$command} or die "Command not permitted: $command";
	
	my @missing = grep { !defined $payload->{$_} } @{$spec->{fields}};
	die "Missing field(s) for $command: @missing" if @missing;

	my $user = $payload->{system_user};
	my $site_path = path($ENV{BLIPTOWN_DATA_HOME}, 'users', $user);
	my $repo_path = path($ENV{BLIPTOWN_DATA_HOME}, 'repos', "$user.git");
	my $private_path = path($site_path, 'private');

	unless ($user eq 'root') {
		my $uid = getpwnam($user) or die "Cannot find user: $user";
		my $gid = getgrnam('bliptown') or die 'Cannot find group: bliptown';

		setgid($gid) or die "Cannot set group: $gid ($!)";
		setuid($uid) or die "Cannot set user: $uid ($!)";

		$private_path->make_path->chmod(0750) or die "Cannot create path: $private_path";
		$repo_path->make_path->chmod(0750) or die "Cannot create path: $repo_path";
	}

	$res = $spec->{func}->($payload);
};
$err = $@;

print STDOUT encode_json({ info => $res, error => $err });
