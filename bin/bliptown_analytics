#!/usr/bin/env perl

use strict;
use warnings;
use File::Basename;
use constant THIS_DIR => dirname(__FILE__);
use lib THIS_DIR . "/../lib", THIS_DIR . "/../local/lib/perl5";

use HTTP::BrowserDetect;
use List::Util qw(max);
use Mojo::File qw(path);
use Mojo::JSON qw(encode_json);
use Mojo::Util qw(trim url_unescape);
use POSIX qw(strftime);

die "$0 must be run as root" unless $> == 0;

my $uid = getpwnam('bliptown');
my $gid = getgrnam('bliptown');

die 'BLIPTOWN_DATA_HOME not defined' unless defined $ENV{BLIPTOWN_DATA_HOME};

my $stats_home = path($ENV{BLIPTOWN_DATA_HOME}, 'stats')->make_path->chmod(0700);
chown $uid, $gid, $stats_home;

my @fields = qw(date path_query referrer system browser mobile country);
my %ua_cache;
my %stats;

sub tally {
	my ($user_stats, $field, $value, $ip_hash) = @_;
	return unless length $value;
	$user_stats->{$field}{$value}{hits}++;
	$user_stats->{$field}{$value}{visitors}{$ip_hash} = 1;
}

while (my $line = <STDIN>) {
	$line = trim $line;
	next unless length $line;
	my ($time, $user, $ip_hash, $host, $path_query, $referrer, $user_agent, $country, $vhost) =
		split /\t/, $line;
	$time =~ s/.*bliptown-visitor: //;
	next unless $time =~ /^\d+$/ && $user;

	my $stats_tally = $stats{$user} //= { map { $_ => {} } @fields };
	my $ua = $ua_cache{$user_agent} //= HTTP::BrowserDetect->new($user_agent);

	tally($stats_tally, 'date', strftime('%Y-%m-%d %a', localtime($time)), $ip_hash);
	tally($stats_tally, 'path_query', url_unescape($path_query // ''), $ip_hash);
	tally($stats_tally, 'system', $ua->os_string, $ip_hash);
	tally($stats_tally, 'browser', $ua->browser_string, $ip_hash);
	tally($stats_tally, 'mobile', $ua->mobile ? 'Mobile' : 'Desktop', $ip_hash);
	tally($stats_tally, 'country', $country || 'unknown', $ip_hash);

	if (length $referrer) {
		unless ($referrer =~ m{^https?://\Q$vhost\E(?:[:/]|$)}) {
			tally($stats_tally, 'referrer', url_unescape($referrer), $ip_hash);
		}
	}
}

sub build_tables {
	my $user_stats = shift;
	my %tables;

	foreach (0..6) {
		my $date = strftime('%Y-%m-%d %a', localtime(time - ($_ * 24 * 60 * 60)));
		$user_stats->{date}{$date}{hits} ||= 0;
	}

	foreach my $field (@fields) {
		my @rows;
		foreach my $value (keys %{$user_stats->{$field}}) {
			push @rows, {
				key			=> $value,
				hits		=> $user_stats->{$field}{$value}{hits},
				visitors	=> scalar keys %{$user_stats->{$field}{$value}{visitors}},
			};
		}
		if ($field eq 'date') {
			@rows = sort { $b->{key} cmp $a->{key} } @rows;
			@rows = splice(@rows, 0, 7);
		}
		else {
			@rows = sort { $b->{hits} <=> $a->{hits} || $a->{key} cmp $b->{key} } @rows;
			@rows = splice(@rows, 0, 10);
		}
		$tables{$field} = \@rows;
	}

	return \%tables;
}

foreach my $user (sort keys %stats) {
	next unless getpwnam $user;
	my $stats_path = path($stats_home, "$user.json")->touch->chmod(0600);
	my $tables = build_tables($stats{$user});
	my $json = encode_json $tables;
	$stats_path->spew($json);
}

my @tree = $stats_home->list_tree({ dir => 1 })->each;
chown $uid, $gid, @tree;
