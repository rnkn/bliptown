#!/usr/bin/env perl

use strict;
use warnings;
use Cwd;
use File::Basename;
use constant THIS_DIR => dirname(__FILE__);
use lib THIS_DIR . '/../local/lib/perl5';

use Mojo::File;
use Term::ReadLine;

binmode STDOUT, ':encoding(UTF-8)';

my $motd_file = Mojo::File->new('/etc/motd');
my $motd = $motd_file->slurp('UTF-8') if -f $motd_file;

my $welcome = <<EOF;
Welcome to your Bliptown shell account. This is a restricted shell
environment. Use 'help' for a list of available commands.
EOF

print "$motd\n" if $motd;
print "$welcome\n";

my $help = <<'EOF';
Available commands:

    help      print this help message
    ls        list directory contents
    ll        list directory contents (detailed)
    pwd       print current directory
    cd        change current directory
    touch     create new file (or update timestamp)
    mkdir     create directories
    rm        delete files
    rmdir     delete directories
    cp        copy files
    mv        move (rename) files
    cat       print (concatenate) files
    grep      file pattern searcher
    quota     print disk quota usage
    tree      print directory file structure
    vi        edit files in vi
    mg        edit files in mg
    nano      edit files in nano
    quit      exit the shell

Server backend commands:

    sftp      upload, download and manage files
    rsync     sync files between a local machine and the server
    git       version control files (snapshots)
EOF

my %allowed_commands = (
	help	=> 1,
	cd		=> 1,
	ls		=> '/bin/ls',
	ll		=> '/bin/ls -alp',
	pwd		=> '/bin/pwd',
	mkdir	=> '/bin/mkdir',
	rm		=> '/bin/rm',
	rmdir	=> '/bin/rmdir',
	cp		=> '/bin/cp',
	mv		=> '/bin/mv',
	cat		=> '/bin/cat',
	grep	=> '/usr/bin/grep',
	quota	=> '/usr/bin/quota',
	touch	=> '/usr/bin/touch',
	vi		=> '/usr/bin/vi -S',
	tree	=> '/usr/pkg/bin/tree',
	nano	=> '/usr/pkg/bin/nano -R',
	mg		=> '/usr/local/bin/mg -S',
);

my %builtins = (
	cd => sub {
		my $dir = shift // $ENV{HOME};
		my $oldpwd = getcwd;
		if ($dir eq '-') {
			chdir $ENV{OLDPWD} or die "cd: $ENV{OLDPWD}: $!\n";
		} else {
			chdir $dir or die "cd: $dir: $!\n";
		}
		$ENV{OLDPWD} = $oldpwd;
	},
	help => sub {
		print "$help\n";
	}
);

$ENV{TERM} = 'vt100';
my $term = Term::ReadLine->new('bliptown-shell');
$term->ornaments(0);

my $prompt = sub {
	my $cwd = getcwd;
	return "$cwd > ";
};

$SIG{INT} = sub { $term->redisplay };

while (1) {
	my $line;
	eval { $line = $term->readline($prompt->()) };
	next if $@;
	last unless defined $line;
	next unless $line;

	my @args = split(/\s+/, $line);
	my $cmd = shift @args;
	last if $cmd eq 'quit';

	my $realcmd = $allowed_commands{$cmd};

	unless ($realcmd) {
		warn "Command '$cmd' not found. Use 'help' for a list of available commands.\n";
		next;
	}

	if (exists $builtins{$cmd}) {
		eval { $builtins{$cmd}->(@args) };
		warn $@ if $@;
		next;
	}

	system(split(/\s+/, $realcmd), @args);
}
